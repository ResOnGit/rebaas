# REBAAS — HTTPS front door (see docker/DEPLOY.md)
#
# API traffic → Envoy (api-gw:8000). Dashboard → Studio (studio:3000) with basic auth.
# Disabled REBAAS services (storage/realtime/functions) are not routed here; Envoy returns 404 if called.

{$PROXY_DOMAIN} {
	@rebaas_api path /auth/v1/* /rest/v1/* /graphql/v1 /pg/*

	handle @rebaas_api {
		reverse_proxy api-gw:8000
	}

	handle {
		basic_auth {
			# PROXY_AUTH_PASSWORD is replaced with a bcrypt hash at container start
			{$PROXY_AUTH_USERNAME} {$PROXY_AUTH_PASSWORD}
		}

		reverse_proxy studio:3000
	}

	header -server
}
